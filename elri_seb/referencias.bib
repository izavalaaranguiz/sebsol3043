@article{haughney2012,
  title = {Defending {{Territory}}, {{Demanding Participation}}: {{Mapuche Struggles}} in {{Chile}}},
  shorttitle = {Defending {{Territory}}, {{Demanding Participation}}},
  author = {Haughney, Diane},
  year = 2012,
  journal = {Latin American Perspectives},
  volume = {39},
  number = {4},
  pages = {201--217},
  issn = {0094-582X, 1552-678X},
  doi = {10.1177/0094582X12441515},
  urldate = {2026-09-02},
  abstract = {The center-left coalition known as the Concertaci\'on used a multifaceted strategy to establish the terms of democracy and participation. Its legal reforms created a set of channels for citizen input but reserved decision-making power for the top level of the executive branch. The Concertaci\'on government openly supported major development projects, characterizing them as necessary for national security and development, and along with corporate interests used neoliberalism as a political philosophy for defining modernity and as a legal framework for the expression of interests and rights. The current rightist administration continues to defend growth at the expense of indigenous rights. Mapuche communities find their collective interests shunted aside and recalibrated as sets of individual interests fewer and of less political significance than those of the nation as a whole. Legal reform has become an ``authoritarianization'' of law and policy making within a democratic framework.             La coalici\'on centro-izquierda conocida como la Concertaci\'on us\'o una estrategia polifac\'etica para establecer los t\'erminos de la democracia y participaci\'on. Su reforma jur\'idica elabor\'o una gama de canales para la participaci\'on ciudadana, pero reserv\'o para la c\'upula mas alta de la rama ejecutiva el poder de la toma de decisiones. El gobierno de la Concertaci\'on apoyoba abiertamente grandes proyectos de desarrollo, caracterizando a estos como necesarios para la seguridad nacional y el desarrollo, y, junto con los intereses de las grandes empresas, us\'o el neoliberalismo como filosof\'ia pol\'itica para definir la modernidad y como marco jur\'idico para expresar intereses y derechos. La actual administraci\'on derechista sigue defendiendo al crecimiento por encima de los derechos ind\'igenas. Encuentran las comunidades Mapuche que sus intereses colectivos se ponen al lado en una nueva calca que hace de ellos conjuntos de intereses individuos, achicados y con menos significado pol\'itico que los de la naci\'on en su total. La reforma jur\'idica se ha vuelto una ``autoritarizaci\'on'' de la ley y la adopci\'on de normas dentro de un marco democr\'atico.},
  langid = {english}
}

@article{herraz2026,
  title = {Plurinationality as an Empty Signifier in the {{Chilean}} Constitutional Convention of 2021--2022: Recognition of Difference and Construction of the Common},
  shorttitle = {Plurinationality as an Empty Signifier in the {{Chilean}} Constitutional Convention of 2021--2022},
  author = {Herraz, Pablo and Murray, Marjorie and Luna, Laura and Pi{\~n}a, Gabriela and Villaz{\'o}n, Nelly},
  year = 2026,
  journal = {Latin American and Caribbean Ethnic Studies},
  pages = {1--22},
  issn = {1744-2222, 1744-2230},
  doi = {10.1080/17442222.2026.2656088},
  urldate = {2026-08-31},
  abstract = {This article examines the history of plurinationality during the Chilean Constitutional Convention of 2021--2022 from an ethnographic perspective. Through the analysis of speeches, internal documents, and semi-structured interviews with Indigenous and non-Indigenous representatives, and drawing on Ernesto Laclau's theory, we examine plurinationality and its evolution as an `empty signifier.' Initially, plurinationality was presented by Indigenous representatives as a signifier without specific content to `fill' it, referring to the general recognition of all Indigenous peoples. However, as the constitutional debate developed, it became `filled' with specific meanings, serving as the theoretical basis of the new state and, simultaneously, the target of conservative attacks, thus shifting from an empty to an ambiguous signifier. We argue that this stems from the difficulty of articulating plurinationality -- which recognizes each nation in its difference -- with interculturality --which seeks a shared space for relations between cultures -- within a single concept and legal figure. This reflects the dilemma between recognizing difference and building the common, which entails both territorial socioeconomic and cultural-symbolic injustice. Nevertheless, the process enabled, for the first time in Chile, a debate on plurinationality led by Indigenous representatives in a body of popular representation, constituting an exercise of what Loughlin calls constitutional imagination.},
  langid = {english},
  file = {..\..\..\..\..\..\..\..\Zotero\storage\GKVDTP69\Herraz et al. - 2026 - Plurinationality as an empty signifier in the Chilean constitutional convention of 2021–2022 recogn.pdf}
}

@article{kiley2020,
  title = {Measuring {{Stability}} and {{Change}} in {{Personal Culture Using Panel Data}}},
  author = {Kiley, Kevin and Vaisey, Stephen},
  year = 2020,
  month = jun,
  journal = {American Sociological Review},
  volume = {85},
  number = {3},
  pages = {477--506},
  issn = {0003-1224, 1939-8271},
  doi = {10.1177/0003122420921538},
  urldate = {2026-08-26},
  abstract = {Models of population-wide cultural change tend to invoke one of two broad models of individual change. One approach theorizes people actively updating their beliefs and behaviors in the face of new information. The other argues that, following early socialization experiences, dispositions are stable. We formalize these two models, elaborate empirical implications of each, and derive a simple combined model for comparing them using panel data. We test this model on 183 attitude and behavior items from the 2006 to 2014 rotating panels of the General Social Survey. The pattern of results is complex but more consistent with the settled dispositions model than with the active updating model. Most of the observed change in the GSS appears to be short-term attitude change or measurement error rather than persisting changes. When persistent change occurs, it is somewhat more likely to occur in younger people and for public behaviors and beliefs about high-profile issues than for private attitudes. We argue that we need both models in our theory of cultural evolution but that we need more research on the circumstances under which each is more likely to apply.},
  langid = {english},
  file = {..\..\..\..\..\..\..\..\Zotero\storage\XXDK25I2\Kiley y Vaisey - Measuring Stability and Change in Personal Culture Using Panel Data.pdf}
}

