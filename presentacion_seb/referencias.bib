@article{adriaans2023,
  title = {Fairness of Earnings in {{Europe}}: The Consequences of Unfair under- and Overreward for Life Satisfaction},
  shorttitle = {Fairness of Earnings in {{Europe}}},
  author = {Adriaans, Jule},
  year = 2023,
  month = feb,
  journal = {European Sociological Review},
  volume = {39},
  number = {1},
  pages = {118--131},
  issn = {0266-7215, 1468-2672},
  doi = {10.1093/esr/jcac044},
  urldate = {2026-08-24},
  abstract = {Abstract             A large percentage of workers in Europe perceive their earnings to be unfairly low. Such perceptions of unfairness can have far-reaching consequences, ranging from low satisfaction to poor health. To gain insight into the conditions that can attenuate or amplify these adverse consequences, comparative research on the role of country contexts in shaping responses to perceived unfairness is needed. Furthermore, justice theory proposes that both types of perceived unfairness---underreward and overreward---cause distress, but evidence on overreward from representative survey data is scarce and laboratory studies have produced mixed results. Data from the European Social Survey (collected in 2018/2019) offer a means of addressing both of these gaps in the research. Studying the association between perceived fairness of personal earnings and life satisfaction in a cross-section of 29 European countries, I find that both underreward and overreward are associated with lower life satisfaction. This relationship is more pronounced in countries where the equity norm is strongly legitimized and weaker in countries where the trade union density is high.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english}
}

@article{adriaans2023a,
  title = {Pay {{Justice}} and {{Pay Satisfaction}}: {{The Influence}} of {{Reciprocity}}, {{Social Comparisons}}, and {{Standard}} of {{Living}}},
  shorttitle = {Pay {{Justice}} and {{Pay Satisfaction}}},
  author = {Adriaans, Jule and Sauer, Carsten and Moya, Crist{\'o}bal},
  year = 2023,
  month = mar,
  journal = {Social Psychology Quarterly},
  volume = {86},
  number = {1},
  pages = {95--106},
  issn = {0190-2725, 1939-8999},
  doi = {10.1177/01902725231151671},
  urldate = {2026-08-24},
  abstract = {This study compares two pay evaluations: pay justice and pay satisfaction. Conceptually, pay justice entails a moral assessment and is more specific to work, whereas pay satisfaction is a broader attitude that includes non-work-related factors. We analyzed German employee data and found overall similarity in determinants but differences in proximity to work contexts. Pay satisfaction was more strongly associated with private pay comparisons and standard of living, whereas pay justice was more strongly associated with reciprocity in the employer-employee relationship through working hours and comparisons at work. The results therefore suggest that employers can influence pay justice more easily than pay satisfaction by means of addressing imbalances in the employer-employee exchange and within organizational pay structures.},
  langid = {english}
}

@article{adriaans2026,
  title = {The {{East}}--{{West Gap}} in {{Pay Fairness Perceptions Converged Between}} 2009 and 2023},
  author = {Adriaans, Jule and Sauer, Carsten},
  year = 2026,
  month = jun,
  journal = {KZfSS K\"olner Zeitschrift f\"ur Soziologie und Sozialpsychologie},
  volume = {78},
  number = {2},
  pages = {413--429},
  issn = {0023-2653, 1861-891X},
  doi = {10.1007/s11577-026-01086-5},
  urldate = {2026-08-24},
  abstract = {This study investigates regional differences in pay fairness perceptions among employees in eastern and western Germany from 2009 to 2023. Using longitudinal data from the Socio-Economic Panel study, the analysis reveals substantial initial disparities: Employees in eastern Germany perceive their gross earnings as more unfair than employees in western Germany do. Over time, however, these regional differences diminish. Analyses stratified by wage deciles show that this convergence in pay fairness is primarily driven by a decrease in unfairness perceptions among low-wage employees in eastern Germany. This development, in turn, is driven by a narrowing East--West gap in actual earnings among low-wage employees. The finding of converging pay fairness perceptions in eastern and western Germany remains robust after adjusting for individual differences (gender, age, education, labor market experience, immigration background) and structural factors (economic area, public sector, organizational size), underscoring that there has been a true convergence of perceptions over time. While this development is cause for optimism, the overall convergence is driven not solely by employees in eastern Germany improving in terms of pay fairness but also by employees in western Germany showing an overall increase in perceived unfairness.},
  langid = {english},
  file = {..\..\..\..\..\..\..\Zotero\storage\5GLWCK64\Adriaans y Sauer - 2026 - The East–West Gap in Pay Fairness Perceptions Converged Between 2009 and 2023.pdf}
}

